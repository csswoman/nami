# Desarrollo (copiar a .env.development.local): Postgres de docker-compose
DATABASE_URL=postgres://nami:nami@localhost:5432/nami
# Tests de integración (servicio db-test)
TEST_DATABASE_URL=postgres://nami:nami@localhost:5433/nami_test
# Producción: las pone `neon init` en .env.local (DATABASE_URL pooled, DATABASE_URL_UNPOOLED para migraciones)
